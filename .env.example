# Configuracion opcional de Kotoduo Produccion (Informe 3, seccion 10)
# Copia este archivo a .env y ajusta lo que necesites. .env esta en .gitignore
# y NUNCA se sube al repositorio: aqui no hay contraseñas ni llaves, solo
# rutas, limites y orígenes.

# --- Base de datos (por defecto: datos/kotoduo.db y datos/documentos.json)
# KOTODUO_DB=/var/lib/kotoduo/kotoduo.db
# KOTODUO_DOC_DB=/var/lib/kotoduo/documentos.json

# --- Cuentas de prueba: archivo de semilla fuera del repositorio
# KOTODUO_SEMILLA=/etc/kotoduo/credenciales_semilla.txt

# --- Documentacion interactiva: 0 la apaga (obligatorio en produccion)
KOTODUO_DOCS=0

# --- Sesion: expiracion de los tokens
KOTODUO_TOKEN_MINUTOS=15      # token de acceso
KOTODUO_REFRESH_HORAS=8       # token de refresco

# --- Bloqueo por intentos fallidos de inicio de sesion
KOTODUO_FALLOS_MAX=3          # fallos hasta bloquear la cuenta
KOTODUO_BLOQUEO_MINUTOS=5     # duracion del bloqueo (HTTP 423 Locked)
KOTODUO_LOGIN_INTENTOS=10     # fallos de login por IP y minuto (HTTP 429)

# --- Limite general de peticiones por IP y minuto (0 lo desactiva)
KOTODUO_LIMITE_GENERAL=1200

# --- CORS: origenes permitidos, separados por coma. Vacio = sin CORS
# (la interfaz se sirve desde el mismo proceso, asi que por defecto no hace
# falta). Nunca se usa el comodin *.
# KOTODUO_CORS_ORIGENES=https://tudominio.com,https://www.tudominio.com

# --- Proxy inverso (Nginx): 1 solo si hay un proxy delante que fije la IP
# real y el esquema en X-Forwarded-For / X-Forwarded-Proto.
KOTODUO_CONFIA_PROXY=1
